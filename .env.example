# Copy this file to ".env" and fill in real values. Never commit .env.
# On the VPS: cp .env.example .env && nano .env && chmod 600 .env

# --- Required ---------------------------------------------------------------
# Claude API key from platform.claude.com → API keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Your GoDaddy domain (no https://, no www), used by Caddy for HTTPS
DOMAIN=yourdomain.com

# Contact form → Titan Business Email (fill in after the mailbox exists)
SMTP_HOST=smtp.titan.email
# If login is rejected, the organizer guide suggests: smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=hello@yourdomain.com
SMTP_PASS=REPLACE_ME
CONTACT_TO=hello@yourdomain.com

# --- Optional (defaults shown) ---------------------------------------------
PORT=3000
# SMTP_SECURE=true            # default: true when SMTP_PORT is 465
# FIX_MODEL=claude-sonnet-5-5
# TASK_MODEL=claude-haiku-5-5
# SUMMARY_MODEL=claude-haiku-5-5
# TRUST_PROXY is set to 1 by docker-compose.yml (Caddy in front)
